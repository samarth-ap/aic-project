# Copy to .env.local and fill in.

# Claude API key (https://platform.claude.com). Without it the app runs in
# offline mode: spikes are still detected, but no AI tutor, no AI concept mapping,
# root causes, catch-up cards or professor brief.
ANTHROPIC_API_KEY=

# Optional
# CHAT_MODEL=claude-sonnet-5-5   # AI tutor (fast). claude-haiku-5-5 is cheaper/faster, claude-opus-5-5 smarter/slower
# CHAT_EFFORT=low                # low | medium | high for the tutor
# CHAT_PER_MINUTE=6              # tutor messages per phone per minute
# CLAUDE_MODEL=claude-opus-5-5   # after-class report
# CLAUDE_EFFORT=medium        # low | medium | high  (higher = slower, more thorough)
# MIN_DEVICES=3               # privacy floor: students needed before a moment is shown (use 5 in real classes)
# PUBLIC_URL=https://your-tunnel.example.com   # what the QR code links to
# DB_PATH=./data/lostfound.db   # SQLite file (used when DATABASE_URL is not set)
# DATABASE_URL=postgres://...    # Postgres (Neon/Supabase). Required on Vercel.
