# Copy to .env.local and fill in.

# Claude API key (https://platform.claude.com). Without it the app runs in
# offline mode: spikes are still detected, but no AI concept mapping,
# root causes, catch-up cards or professor brief.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high  (higher = slower, more thorough)
# MIN_DEVICES=3               # privacy floor: students needed before a moment is shown (use 5 in real classes)
# PUBLIC_URL=https://your-tunnel.example.com   # what the QR code links to
# DB_PATH=./data/lostfound.db
