# Copy to .env.local and fill in. Everything is optional for local development.

# ---------- AI ----------
# Claude API key (https://platform.claude.com). Without an AI key the app runs in
# offline mode: the tutor quotes what was just said instead of explaining it.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-sonnet-5-5     # tutor, running summary, study checks (fast)
# CHAT_EFFORT=low
# CLAUDE_MODEL=claude-opus-5-5     # after-lecture analysis
# CLAUDE_EFFORT=medium
# CHAT_PER_MINUTE=8                # tutor messages per student per minute

# Free alternative: Groq (https://console.groq.com). Used when there's no ANTHROPIC_API_KEY
# (or set AI_PROVIDER=groq if both are set).
# GROQ_API_KEY=
# AI_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GROQ_TUTOR_WINDOW_MIN=12

# ---------- sign-in ----------
# Who may sign in: comma-separated domains, or * for anyone.
# ALLOWED_EMAIL_DOMAINS=uw.edu

# Email codes via Resend (https://resend.com). Without these, local dev shows the code on screen.
# RESEND_API_KEY=
# EMAIL_FROM=Lost and Found <login@yourdomain.edu>
# DEV_LOGIN=0      # 0 = never show codes on screen. NEVER set 1 on a public deployment.

# Google sign-in (see README)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Apple (see README; needs https)
# APPLE_CLIENT_ID=          # the Services ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ---------- hosting ----------
# PUBLIC_URL=https://your-tunnel.example.com   # what QR codes link to
# DATABASE_URL=postgres://...                  # Postgres (Neon/Supabase). Required on Vercel.
# DB_PATH=./data/lostfound.db                  # SQLite file when DATABASE_URL is not set
